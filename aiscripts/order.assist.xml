<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<diff>
    <!-- a subordinate on Assist runs the commander's Smart Minelayer order; a promoted one gets it as its default -->
    <add sel="/aiscript/attention[@min='unknown']/actions/do_if[@value='$order.exists or (@$orderdef and $createdefaultorder?)']/do_if[@value='(@$orderdef and $createdefaultorder?) or not $order.requiredskill or (this.combinedskill ge $order.requiredskill)']">
        <do_elseif value="$orderdef.$id == 'SmartMinelayer'">
            <set_value name="$added" />
            <do_if value="@this.assignedcontrolled.order.isrunning">
                <clear_order_failure order="this.assignedcontrolled.order" />
            </do_if>
            <do_if value="$createdefaultorder?">
                <create_order id="$orderdef.$id" object="this.assignedcontrolled" default="true">
                    <param name="targetPosition" value="$orderdef.$targetPosition" />
                    <param name="targetObject" value="$orderdef.$targetObject" />
                </create_order>
            </do_if>
            <do_else>
                <set_value name="$orderdef.$targetPosition" exact="$order.$targetPosition" />
                <set_value name="$orderdef.$targetObject" exact="$order.$targetObject" />
                <run_script name="$scriptname">
                    <param name="targetPosition" value="$order.$targetPosition" />
                    <param name="targetObject" value="$order.$targetObject" />
                </run_script>
            </do_else>
        </do_elseif>
    </add>
</diff>
