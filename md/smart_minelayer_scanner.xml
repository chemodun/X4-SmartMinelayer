<?xml version="1.0" encoding="utf-8"?>
<mdscript name="SmartMinelayerScanner" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!-- The engine drops a mine's trigger sensor below attention visible; this script detonates such mines instead.
       It also keeps the common slot list player.entity.$SmartMinelayer.$slots: dead item records, slots no ship lists, lost slots. -->
  <cues>

    <library name="SML_ScannerParams" purpose="include_actions">
      <actions>
        <set_value name="$scanInterval" exact="3s" />
        <!-- while an enemy is within $trackRange of the field's reach -->
        <set_value name="$alertInterval" exact="1s" />
        <set_value name="$trackRange" exact="40km" />
        <set_value name="$maxFieldsPerTick" exact="4" />
        <set_value name="$sweepInterval" exact="60s" />
        <set_value name="$maxSweepsPerTick" exact="2" />
      </actions>
    </library>

    <!-- in $stats (from the window, may be null); out $reach, $damage, $hull, $shield -->
    <library name="SML_MineValues" purpose="include_actions">
      <actions>
        <!-- a tracking mine's follow range, when the window gave none: 1000 m on every vanilla one -->
        <set_value name="$reach" exact="1000m" />
        <set_value name="$damage" exact="10000" />
        <set_value name="$hull" exact="0" />
        <set_value name="$shield" exact="0" />
        <do_if value="$stats">
          <do_if value="$stats.$tracking != 1">
            <set_value name="$reach" exact="($stats.$range)m" />
          </do_if>
          <do_elseif value="$stats.$follow? and $stats.$follow gt 0">
            <set_value name="$reach" exact="($stats.$follow)m" />
          </do_elseif>
          <set_value name="$damage" exact="$stats.$damage" />
          <set_value name="$hull" exact="$stats.$hull" />
          <set_value name="$shield" exact="$stats.$shield" />
        </do_if>
      </actions>
    </library>

    <!-- in $d0, $d1: distances from a point to a path's ends, $len: path length, $r; out $near: the path passes within $r -->
    <library name="SML_PathNear" purpose="include_actions">
      <actions>
        <set_value name="$near" exact="$d0 le $r or $d1 le $r" />
        <do_if value="not $near and $len gt 0m">
          <set_value name="$along" exact="($d0 * $d0 - $d1 * $d1 + $len * $len) / (2 * $len)" />
          <do_if value="$along gt 0m and $along lt $len">
            <set_value name="$near" exact="$d0 * $d0 - $along * $along le $r * $r" />
          </do_if>
        </do_if>
      </actions>
    </library>

    <!-- in $slots, $key: a slot no ship lists; its mines stay watched until the last is gone, anything else goes -->
    <library name="SML_DropEntry" purpose="include_actions">
      <actions>
        <set_value name="$drop" exact="$slots.{$key}" />
        <do_if value="$drop.$scan? and $drop.$items.keys.count gt 0">
          <remove_value name="$drop.$config" />
          <remove_value name="$drop.$positions" />
          <remove_value name="$drop.$threshold" />
          <remove_value name="$drop.$missing" />
          <remove_value name="$drop.$inFlight" />
          <remove_value name="$drop.$refill" />
          <remove_value name="$drop.$lost" />
          <remove_value name="$drop.$lostAt" />
        </do_if>
        <do_else>
          <remove_value name="$slots.{$key}" />
        </do_else>
        <remove_value name="$drop" />
      </actions>
    </library>

    <cue name="Scanner" namespace="this">
      <cues>

        <cue name="Tick">
          <delay exact="1s" />
          <actions>
            <do_if value="player.entity.$SmartMinelayer?">
              <include_actions ref="md.SmartMinelayer.ReadDebugChances" />
              <include_actions ref="SML_ScannerParams" />
              <set_value name="$slots" exact="player.entity.$SmartMinelayer.$slots" />
              <!-- an existence check: 0 equals null -->
              <set_value name="$ttl" exact="(if player.entity.$SmartMinelayerConfig? and player.entity.$SmartMinelayerConfig.$lostTtl? then player.entity.$SmartMinelayerConfig.$lostTtl else 1) * 1h" />
              <set_value name="$due" exact="[]" />
              <set_value name="$sweepDue" exact="[]" />

              <do_for_each name="$key" in="$slots.keys.list">
                <set_value name="$e" exact="$slots.{$key}" />
                <do_if value="$e.$config? and $e.$lost?">
                  <do_if value="player.age ge $e.$lostAt + $ttl">
                    <debug_text text="'SmartMinelayer: scanner: lost slot %s of %s expired'.[$e.$uid, @$e.$ship.debugname]" chance="$debugChance" />
                    <include_actions ref="SML_DropEntry" />
                  </do_if>
                </do_if>
                <!-- the AI pilot holds the list: the player takes the pilot seat when flying the ship -->
                <do_elseif value="$e.$config? and not @$e.$ship.assignedaipilot.$SmartMinelayerSlotIds.indexof.{$e.$uid}">
                  <!-- rare (owner destroyed, pilot swapped, order removed): a commander first, else a wingman's copy -->
                  <set_value name="$owner" exact="null" />
                  <find_ship name="$candidates" owner="faction.player" space="player.galaxy" multiple="true" />
                  <do_for_each name="$candidate" in="$candidates">
                    <do_if value="@$candidate.assignedaipilot.$SmartMinelayerSlotIds.indexof.{$e.$uid}">
                      <set_value name="$owner" exact="$candidate" />
                      <do_if value="@$candidate.defaultorder.id == 'SmartMinelayer'">
                        <break />
                      </do_if>
                    </do_if>
                  </do_for_each>
                  <do_if value="$owner">
                    <debug_text text="'SmartMinelayer: scanner: slot %s passes from %s to %s'.[$e.$uid, @$e.$ship.debugname, $owner.debugname]" chance="$debugChance" />
                    <set_value name="$e.$ship" exact="$owner" />
                  </do_if>
                  <do_elseif value="not @$e.$ship.exists and $ttl gt 0s">
                    <debug_text text="'SmartMinelayer: scanner: slot %s lost with its ship, kept for %s'.[$e.$uid, $ttl]" chance="$debugChance" />
                    <set_value name="$e.$lost" exact="true" />
                    <set_value name="$e.$lostAt" exact="player.age" />
                  </do_elseif>
                  <do_else>
                    <debug_text text="'SmartMinelayer: scanner: no ship lists slot %s of %s, dropped'.[$e.$uid, @$e.$ship.debugname]" chance="$debugChance" />
                    <include_actions ref="SML_DropEntry" />
                  </do_else>
                  <remove_value name="$owner" />
                  <remove_value name="$candidates" />
                  <remove_value name="$candidate" />
                </do_elseif>
                <!-- items to collect whose ship is gone or off the order: its mines stay watched, anything else goes -->
                <do_elseif value="@$e.$collect">
                  <set_value name="$collector" exact="false" />
                  <do_if value="@$e.$ship.isoperational and @$e.$ship.assignedaipilot.exists">
                    <set_value name="$collector" exact="$e.$ship.assignedaipilot.$SmartMinelayerSlotIds?" />
                  </do_if>
                  <do_if value="not $collector">
                    <debug_text text="'SmartMinelayer: scanner: %s no longer collects %s, %s items left in space'.[@$e.$ship.debugname, $e.$uid, $e.$items.keys.count]" chance="$debugChance" />
                    <remove_value name="$e.$collect" />
                    <remove_value name="$e.$inFlight" />
                    <do_if value="not $e.$scan?">
                      <remove_value name="$slots.{$key}" />
                    </do_if>
                  </do_if>
                  <remove_value name="$collector" />
                </do_elseif>
                <do_if value="$slots.{$key}?">
                  <do_if value="@$e.$nextSweep le player.age">
                    <append_to_list name="$sweepDue" exact="$key" />
                  </do_if>
                  <do_if value="$e.$scan? and $e.$scan.$nextScan le player.age">
                    <append_to_list name="$due" exact="$key" />
                  </do_if>
                </do_if>
              </do_for_each>

              <!-- a record first seen dead goes one sweep later, after its kill event; a mines-only slot goes with its last record -->
              <do_if value="$sweepDue.count gt $maxSweepsPerTick">
                <sort_list list="$sweepDue" sortbyvalue="@$slots.{loop.element}.$nextSweep" />
              </do_if>
              <do_all exact="[$sweepDue.count, $maxSweepsPerTick].min" counter="$n">
                <set_value name="$key" exact="$sweepDue.{$n}" />
                <set_value name="$e" exact="$slots.{$key}" />
                <set_value name="$e.$nextSweep" exact="player.age + $sweepInterval" />
                <do_for_each name="$m" in="if $e.$dead? then $e.$dead else []">
                  <do_if value="$e.$items.{$m}?">
                    <remove_value name="$e.$items.{$m}" />
                  </do_if>
                </do_for_each>
                <set_value name="$e.$dead" exact="[]" />
                <do_for_each name="$m" in="$e.$items.keys.list">
                  <do_if value="not $m.exists">
                    <append_to_list name="$e.$dead" exact="$m" />
                  </do_if>
                </do_for_each>
                <do_if value="not $e.$config? and $e.$items.keys.count == 0">
                  <debug_text text="'SmartMinelayer: scanner: slot %s without a layout has no items left, removed'.[$e.$uid]" chance="$debugChance" />
                  <remove_value name="$slots.{$key}" />
                </do_if>
                <do_else>
                  <debug_text text="'SmartMinelayer: scanner: slot %s swept, records %s, dead %s'.[$e.$uid, $e.$items.keys.count, $e.$dead.count]" chance="$traceChance" />
                </do_else>
              </do_all>

              <!-- the longest overdue first, so no slot starves when more are due than one tick scans -->
              <do_if value="$due.count gt $maxFieldsPerTick">
                <sort_list list="$due" sortbyvalue="@$slots.{loop.element}.$scan.$nextScan" />
              </do_if>
              <do_all exact="[$due.count, $maxFieldsPerTick].min" counter="$n">
                <set_value name="$key" exact="$due.{$n}" />
                <do_if value="$slots.{$key}?">
                  <set_value name="$e" exact="$slots.{$key}" />
                  <set_value name="$field" exact="$e.$scan" />
                  <set_value name="$field.$nextScan" exact="player.age + $scanInterval" />
                  <do_if value="not $field.$reach?">
                    <set_value name="$stats" exact="@$field.$stats" />
                    <include_actions ref="SML_MineValues" />
                    <set_value name="$field.$reach" exact="$reach" />
                    <set_value name="$field.$damage" exact="$damage" />
                    <set_value name="$field.$hull" exact="$hull" />
                    <set_value name="$field.$shield" exact="$shield" />
                    <debug_text text="'SmartMinelayer: scanner slot %s in %s: reach %s, damage %s, hull %s, shield %s'.[$e.$uid, @$e.$sector.debugname, $reach, $damage, $hull, $shield]" chance="$debugChance" />
                  </do_if>
                  <set_value name="$mines" exact="[]" />
                  <do_for_each name="$m" in="$e.$items.keys.list">
                    <do_if value="$m.exists and $m.isclass.mine">
                      <append_to_list name="$mines" exact="$m" />
                    </do_if>
                  </do_for_each>

                  <!-- a changed count, or a launch (count -1), means new bounds -->
                  <do_if value="$mines.count gt 0 and $mines.count != $field.$count">
                    <set_value name="$sx" exact="0m" />
                    <set_value name="$sy" exact="0m" />
                    <set_value name="$sz" exact="0m" />
                    <do_for_each name="$m" in="$mines">
                      <create_position name="$p" space="$e.$sector" object="$m" />
                      <set_value name="$sx" operation="add" exact="$p.x" />
                      <set_value name="$sy" operation="add" exact="$p.y" />
                      <set_value name="$sz" operation="add" exact="$p.z" />
                    </do_for_each>
                    <set_value name="$field.$center" exact="position.[$sx / $mines.count, $sy / $mines.count, $sz / $mines.count]" />
                    <set_value name="$field.$radius" exact="0m" />
                    <do_for_each name="$m" in="$mines">
                      <set_value name="$d" exact="$m.distanceto.[$e.$sector, $field.$center]" />
                      <do_if value="$d gt $field.$radius">
                        <set_value name="$field.$radius" exact="$d" />
                      </do_if>
                    </do_for_each>
                    <set_value name="$field.$count" exact="$mines.count" />
                    <debug_text text="'SmartMinelayer: scanner slot %s bounds: mines %s, center %s, radius %s'.[$e.$uid, $mines.count, $field.$center, $field.$radius]" chance="$debugChance" />
                  </do_if>

                  <set_value name="$found" exact="0" />
                  <set_value name="$crossing" exact="0" />
                  <set_value name="$checks" exact="0" />
                  <set_value name="$hits" exact="0" />
                  <set_value name="$track" exact="table[]" />
                  <do_if value="$mines.count gt 0">
                    <find_ship name="$ships" space="$e.$sector" multiple="true" docked="false">
                      <match_distance space="$e.$sector" value="$field.$center" max="$field.$radius + $field.$reach + $trackRange" />
                      <match_relation_of object="$mines.{1}" relation="enemy" comparison="le" />
                    </find_ship>
                    <set_value name="$found" exact="$ships.count" />
                    <do_if value="$found gt 0">
                      <set_value name="$field.$nextScan" exact="player.age + $alertInterval" />
                    </do_if>
                    <do_if value="not $field.$track?">
                      <set_value name="$field.$track" exact="table[]" />
                    </do_if>
                    <!-- low-attention positions jump by kilometres: test the path since the last read, not the point -->
                    <set_value name="$crossers" exact="[]" />
                    <set_value name="$from" exact="table[]" />
                    <set_value name="$moved" exact="table[]" />
                    <!-- distances run centre to centre: a large hull reaches half its size closer -->
                    <set_value name="$extent" exact="table[]" />
                    <do_for_each name="$s" in="$ships">
                      <create_position name="$p" space="$e.$sector" object="$s" />
                      <set_value name="$track.{$s}" exact="$p" />
                      <set_value name="$from.{$s}" exact="if $field.$track.{$s}? then $field.$track.{$s} else $p" />
                      <set_value name="$moved.{$s}" exact="$from.{$s}.distanceto.{$p}" />
                      <set_value name="$extent.{$s}" exact="$s.size / 2" />
                      <set_value name="$d0" exact="$field.$center.distanceto.{$from.{$s}}" />
                      <set_value name="$d1" exact="$field.$center.distanceto.{$p}" />
                      <set_value name="$len" exact="$moved.{$s}" />
                      <set_value name="$r" exact="$field.$radius + $field.$reach + $extent.{$s}" />
                      <include_actions ref="SML_PathNear" />
                      <do_if value="$near">
                        <append_to_list name="$crossers" exact="$s" />
                      </do_if>
                    </do_for_each>
                    <set_value name="$crossing" exact="$crossers.count" />
                    <do_for_each name="$m" in="$mines">
                      <do_if value="$crossers.count == 0">
                        <break />
                      </do_if>
                      <!-- at visible and above the engine's own sensor does the work -->
                      <do_if value="$m.exists and $m.attention lt attention.visible">
                        <do_for_each name="$s" in="$crossers">
                          <set_value name="$checks" operation="add" />
                          <set_value name="$r" exact="$field.$reach + $extent.{$s}" />
                          <set_value name="$len" exact="$moved.{$s}" />
                          <set_value name="$d1" exact="$m.distanceto.[$e.$sector, $track.{$s}]" />
                          <set_value name="$d0" exact="if $len gt 0m then $m.distanceto.[$e.$sector, $from.{$s}] else $d1" />
                          <include_actions ref="SML_PathNear" />
                          <do_if value="$near">
                            <set_value name="$victim" exact="$s" />
                            <break />
                          </do_if>
                        </do_for_each>
                        <do_if value="$victim?">
                          <apply_attackstrength object="$victim" attacker="$m" explosion="true" hullshield="$field.$damage" hullonly="$field.$hull" shieldonly="$field.$shield" hullnoshield="0">
                            <result killed="$killed" />
                          </apply_attackstrength>
                          <debug_text text="'SmartMinelayer: scanner slot %s: %s detonated on %s (moved %s since the last scan, now %s off), killed %s'.[$e.$uid, $m.debugname, $victim.debugname, $moved.{$victim}, $d1, @$killed]" chance="$debugChance" />
                          <do_if value="@$killed">
                            <remove_from_list name="$crossers" exact="$victim" />
                          </do_if>
                          <destroy_object object="$m" explosion="true" />
                          <set_value name="$hits" operation="add" />
                          <remove_value name="$victim" />
                          <remove_value name="$killed" />
                        </do_if>
                      </do_if>
                    </do_for_each>
                  </do_if>
                  <set_value name="$field.$track" exact="$track" />
                  <debug_text text="'SmartMinelayer: scanner slot %s scan: mines %s, ships %s, crossing %s, checks %s, hits %s, next in %s'.[$e.$uid, $mines.count, $found, $crossing, $checks, $hits, $field.$nextScan - player.age]" chance="$traceChance" />
                </do_if>
              </do_all>

              <remove_value name="$slots" />
              <remove_value name="$ttl" />
              <remove_value name="$due" />
              <remove_value name="$sweepDue" />
              <remove_value name="$n" />
              <remove_value name="$key" />
              <remove_value name="$e" />
              <remove_value name="$field" />
              <remove_value name="$mines" />
              <remove_value name="$ships" />
              <remove_value name="$m" />
              <remove_value name="$s" />
              <remove_value name="$p" />
              <remove_value name="$d" />
              <remove_value name="$sx" />
              <remove_value name="$sy" />
              <remove_value name="$sz" />
              <remove_value name="$found" />
              <remove_value name="$checks" />
              <remove_value name="$hits" />
              <remove_value name="$crossers" />
              <remove_value name="$crossing" />
              <remove_value name="$track" />
              <remove_value name="$from" />
              <remove_value name="$moved" />
              <remove_value name="$extent" />
              <remove_value name="$d0" />
              <remove_value name="$d1" />
              <remove_value name="$len" />
              <remove_value name="$r" />
              <remove_value name="$near" />
              <remove_value name="$along" />
              <remove_value name="$scanInterval" />
              <remove_value name="$alertInterval" />
              <remove_value name="$trackRange" />
              <remove_value name="$maxFieldsPerTick" />
              <remove_value name="$sweepInterval" />
              <remove_value name="$maxSweepsPerTick" />
              <remove_value name="$stats" />
              <remove_value name="$reach" />
              <remove_value name="$damage" />
              <remove_value name="$hull" />
              <remove_value name="$shield" />
              <include_actions ref="md.SmartMinelayer.ClearDebugChances" />
            </do_if>
            <reset_cue cue="this" />
          </actions>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>
