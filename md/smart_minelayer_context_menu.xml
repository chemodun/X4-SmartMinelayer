<?xml version="1.0" encoding="utf-8"?>
<mdscript name="SmartMinelayerContextMenu" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!-- "Configure Smart Minelayer" on a ship whose default order is Smart Minelayer, nothing else selected: opens its slots to edit or delete, or without slots the first slot's window for the order's target.
       "Add Minelayer Position" for selected minelayers on a spot in space, a station or a gate: adds a slot there. -->
  <cues>
    <cue name="Main" version="3">
      <cues>

        <cue name="SML_Add_Menu_Actions" instantiate="true">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
            <check_value value="@event.param.$object.exists" />
            <check_value value="@event.param.$object.defaultorder.id == 'SmartMinelayer'" />
            <check_value value="not @event.param.$selectedotherobjects.count and not @event.param.$selectedplayerdeployables.count" />
          </conditions>
          <actions>
            <!-- the ship itself and the occupied ship (listed by default) do not count as other objects -->
            <set_value name="$otherShips" exact="0" />
            <do_for_each name="$selShip" in="@event.param.$selectedplayerships">
              <do_if value="$selShip != event.param.$object and $selShip != player.occupiedship">
                <set_value name="$otherShips" operation="add" />
              </do_if>
            </do_for_each>
            <remove_value name="$selShip" />
            <do_if value="$otherShips == 0">
              <!-- slots to edit, a window the order waits for, or a target for the first slot -->
              <set_value name="$configPilot" exact="@event.param.$object.assignedaipilot" />
              <set_value name="$configOrder" exact="event.param.$object.defaultorder" />
              <set_value name="$configActive" exact="if @$configPilot.$SmartMinelayerSlotIds.count gt 0 or typeof @$configPilot.$SmartMinelayerConfigRequestData == datatype.table or @$configOrder.$targetObject.exists or @$configOrder.$targetPosition.{1}.exists then true else false" />
              <!-- deleted slots whose items are still collected are hidden from the window -->
              <set_value name="$configCollecting" exact="false" />
              <do_if value="not $configActive and @$configPilot.$SmartMinelayerCollectIds.count gt 0">
                <do_for_each name="$configUid" in="$configPilot.$SmartMinelayerCollectIds">
                  <do_if value="@player.entity.$SmartMinelayer.$slots.{'$' + $configUid}.$collect">
                    <set_value name="$configCollecting" exact="true" />
                    <break />
                  </do_if>
                </do_for_each>
                <remove_value name="$configUid" />
              </do_if>
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id        = 'smart_minelayer_configure',
                  $section   = 'main_orders',
                  $icon      = 'order_smartminelayer',
                  $text      = {1972092417, 10016},
                  $mouseover = if $configActive then '' else if $configCollecting then {1972092417, 10022} else {1972092417, 10021},
                  $active    = $configActive,
                  $callback  = SML_Configure_Callback,
                ]" />
              <remove_value name="$configPilot" />
              <remove_value name="$configOrder" />
              <remove_value name="$configActive" />
              <remove_value name="$configCollecting" />
            </do_if>
            <remove_value name="$otherShips" />
          </actions>
        </cue>

        <cue name="SML_Configure_Callback" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.SmartMinelayer.ReadDebugChances" />
            <set_value name="$configShip" exact="event.param.$object" />
            <!-- the order runs on the AI pilot, which keeps the blackboard while the player flies the ship -->
            <set_value name="$configPilot" exact="@$configShip.assignedaipilot" />
            <set_value name="$configRequest" exact="@$configPilot.$SmartMinelayerConfigRequestData" />
            <do_if value="@$configShip.defaultorder.id != 'SmartMinelayer' or not @$configPilot.exists">
              <debug_text text="'SmartMinelayer: context menu Configure for %s, which has no Smart Minelayer order'.[@$configShip.debugname]" filter="error" />
            </do_if>
            <!-- a request the order is waiting for is shown as it is, not replaced by a Configure window -->
            <do_elseif value="typeof $configRequest == datatype.table and not @$configRequest.$fromConfigure">
              <raise_lua_event name="'SmartMinelayer.Configure'" param="$configPilot" />
              <debug_text text="'SmartMinelayer: context menu showed the pending config window of %s'.[$configShip.debugname]" chance="$debugChance" />
            </do_elseif>
            <!-- no slot yet: the order restarts and opens the first slot's window for its target -->
            <do_elseif value="not @$configPilot.$SmartMinelayerSlotIds.count">
              <do_if value="@$configShip.defaultorder.$targetObject.exists or @$configShip.defaultorder.$targetPosition.{1}.exists">
                <edit_order_param order="$configShip.defaultorder" param="'targetAdd'" value="true" />
                <debug_text text="'SmartMinelayer: context menu restarted the order of %s for its first slot'.[$configShip.debugname]" chance="$debugChance" />
              </do_if>
            </do_elseif>
            <do_else>
              <!-- the window's copy of the ship's slots in tab order, from the common list -->
              <set_value name="$configureSlots" exact="[]" />
              <do_for_each name="$configureUid" in="$configPilot.$SmartMinelayerSlotIds">
                <set_value name="$configureEntry" exact="@player.entity.$SmartMinelayer.$slots.{'$' + $configureUid}" />
                <do_if value="typeof $configureEntry == datatype.table and $configureEntry.$config?">
                  <append_to_list name="$configureSlots" exact="table[$uid = $configureUid, $config = $configureEntry.$config, $positions = $configureEntry.$positions]" />
                </do_if>
              </do_for_each>
              <set_value name="$configPilot.$SmartMinelayerConfigRequestData" exact="table[
                $callbackObject = $configShip,
                $fromConfigure = true,
                $equipmentStations = [],
                $slots = $configureSlots]" />
              <remove_value name="$configureSlots" />
              <remove_value name="$configureUid" />
              <remove_value name="$configureEntry" />
              <raise_lua_event name="'SmartMinelayer.Configure'" param="$configPilot" />
              <debug_text text="'SmartMinelayer: context menu opened the config window for %s'.[$configShip.debugname]" chance="$debugChance" />
            </do_else>
            <remove_value name="$configShip" />
            <remove_value name="$configPilot" />
            <remove_value name="$configRequest" />
            <include_actions ref="md.SmartMinelayer.ClearDebugChances" />
          </actions>
        </cue>

        <!-- in: event.param of the menu; out: $addShips, and $addSector + $addPos (+ $addObject) when the target fits -->
        <library name="ResolveAddTarget" purpose="include_actions">
          <actions>
            <set_value name="$addShips" exact="[]" />
            <do_for_each name="$addShip" in="@event.param.$selectedplayerships">
              <!-- a first slot comes from the Behaviour panel; 9 = maxSlots in ui/smart_minelayer.lua -->
              <set_value name="$addSlotCount" exact="@$addShip.assignedaipilot.$SmartMinelayerSlotIds.count" />
              <do_if value="@$addShip.defaultorder.id == 'SmartMinelayer' and $addShip != player.occupiedship and $addSlotCount gt 0 and $addSlotCount lt 9">
                <append_to_list name="$addShips" exact="$addShip" />
              </do_if>
            </do_for_each>
            <remove_value name="$addSlotCount" />
            <remove_value name="$addShip" />
            <set_value name="$addSector" exact="null" />
            <set_value name="$addPos" exact="null" />
            <set_value name="$addObject" exact="null" />
            <set_value name="$addTarget" exact="@event.param.$object" />
            <do_if value="@$addTarget.isclass.station or @$addTarget.isclass.gate">
              <set_value name="$addObject" exact="$addTarget" />
              <set_value name="$addSector" exact="$addTarget.sector" />
              <create_position name="$addPos" space="$addSector" object="$addTarget" />
            </do_if>
            <do_elseif value="(not @$addTarget.exists or $addTarget.isclass.space) and @event.param.$offsetcomponent.exists and @event.param.$offset">
              <set_value name="$addSector" exact="if event.param.$offsetcomponent.isclass.sector then event.param.$offsetcomponent else event.param.$offsetcomponent.sector" />
              <do_if value="@$addSector.isclass.sector">
                <create_position name="$addPos" space="$addSector" object="event.param.$offsetcomponent" value="event.param.$offset" />
              </do_if>
              <do_else>
                <set_value name="$addSector" exact="null" />
              </do_else>
            </do_elseif>
            <remove_value name="$addTarget" />
          </actions>
        </library>

        <cue name="SML_Add_Position_Actions" instantiate="true">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
            <check_value value="@event.param.$selectedplayerships.count gt 0" />
          </conditions>
          <actions>
            <include_actions ref="ResolveAddTarget" />
            <do_if value="$addShips.count gt 0 and @$addSector.exists">
              <signal_cue_instantly
                cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id       = 'smart_minelayer_add_position',
                  $section  = 'selected_orders',
                  $icon     = 'order_smartminelayer',
                  $text     = {1972092417, 10020},
                  $callback = SML_Add_Position_Callback,
                ]" />
            </do_if>
            <remove_value name="$addShips" />
            <remove_value name="$addSector" />
            <remove_value name="$addPos" />
            <remove_value name="$addObject" />
          </actions>
        </cue>

        <!-- a new default order with targetAdd on: it opens the config window for the target -->
        <cue name="SML_Add_Position_Callback" instantiate="true">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="md.SmartMinelayer.ReadDebugChances" />
            <include_actions ref="ResolveAddTarget" />
            <do_if value="@$addSector.exists">
              <do_for_each name="$addShip" in="$addShips">
                <create_order id="'SmartMinelayer'" object="$addShip" default="true">
                  <param name="targetPosition" value="[$addSector, $addPos]" />
                  <param name="targetObject" value="$addObject" />
                  <param name="targetAdd" value="true" />
                </create_order>
                <debug_text text="'SmartMinelayer: context menu added a position for %s in %s at %s, object %s'.[$addShip.debugname, $addSector.debugname, $addPos, @$addObject.debugname]" chance="$debugChance" />
              </do_for_each>
              <remove_value name="$addShip" />
            </do_if>
            <remove_value name="$addShips" />
            <remove_value name="$addSector" />
            <remove_value name="$addPos" />
            <remove_value name="$addObject" />
            <include_actions ref="md.SmartMinelayer.ClearDebugChances" />
          </actions>
        </cue>

      </cues>
    </cue>
  </cues>
</mdscript>
