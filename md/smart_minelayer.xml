<?xml version="1.0" encoding="utf-8"?>
<mdscript name="SmartMinelayer" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <cues>
    <library name="ReadDebugChances" purpose="include_actions">
      <actions>
        <set_value name="$smlDebugLevel" exact="if @player.entity.$SmartMinelayerConfig.$debugLevel != null then player.entity.$SmartMinelayerConfig.$debugLevel else 'none'" />
        <set_value name="$debugChance" exact="if @$smlDebugLevel == null or @$smlDebugLevel == 'none' then 0 else 100" />
        <set_value name="$traceChance" exact="if @$smlDebugLevel == 'trace' then 100 else 0" />
        <remove_value name="$smlDebugLevel" />
      </actions>
    </library>

    <library name="ClearDebugChances" purpose="include_actions">
      <actions>
        <remove_value name="$debugChance" />
        <remove_value name="$traceChance" />
      </actions>
    </library>

    <library name="Ensure_Config" purpose="include_actions">
      <actions>
        <set_value name="$cfg" exact="table[$debugLevel = 'none', $restockNpc = 0, $lostTtl = 4]" />
        <do_if value="@player.entity.$SmartMinelayerConfig == null">
          <set_value name="player.entity.$SmartMinelayerConfig" exact="$cfg" />
        </do_if>
        <do_else>
          <do_for_each name="$key" in="$cfg">
            <do_if value="not player.entity.$SmartMinelayerConfig.{$key}?">
              <set_value name="player.entity.$SmartMinelayerConfig.{$key}" exact="$cfg.{$key}" />
            </do_if>
          </do_for_each>
          <remove_value name="$key" />
        </do_else>
        <remove_value name="$cfg" />
      </actions>
    </library>

    <cue name="Init" version="1">
      <actions>
        <include_actions ref="Ensure_Config" />
        <raise_lua_event name="'SmartMinelayer.ConfigChanged'" />
      </actions>
      <cues>

        <cue name="On_Game_Loaded" instantiate="true" version="1">
          <conditions>
            <event_game_loaded />
          </conditions>
          <actions>
            <include_actions ref="Ensure_Config" />
            <raise_lua_event name="'SmartMinelayer.ConfigChanged'" />
          </actions>
        </cue>

        <cue name="Register_Menu" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled cue="@md.Simple_Menu_API.Reloaded" />
            <check_value value="@md.Options_Helper.Add_Dropdown.exists" />
          </conditions>
          <actions>
            <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
              param="table[
                $id      = 'smart_minelayer_options_menu',
                $columns = 12,
                $title   = {1972092417, 1},
                $onOpen  = Options_Menu,
              ]" />
          </actions>
        </cue>

        <cue name="Options_Menu" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="Ensure_Config" />
            <set_value name="$cfg" exact="player.entity.$SmartMinelayerConfig" />
            <run_actions ref="md.Options_Helper.Add_Title_Row">
              <param name="title" value="{1972092417, 90800}" />
            </run_actions>
            <run_actions ref="md.Options_Helper.Add_Slider">
              <param name="id" value="'lostTtl'" />
              <param name="min" value="0" />
              <param name="max" value="24" />
              <param name="step" value="1" />
              <param name="text" value="{1972092417, 90810}" />
              <param name="mouseOverText" value="{1972092417, 90811}" />
              <param name="suffix" value="' h'" />
              <param name="colSpan" value="6" />
              <param name="textColSpan" value="6" />
              <param name="data" value="$cfg" />
              <param name="handle" value="Handle_Slider_Changed" />
            </run_actions>
            <run_actions ref="md.Options_Helper.Add_Title_Row">
              <param name="title" value="{1972092417, 90900}" />
            </run_actions>
            <set_value name="$debugLevelOptions" exact="[
              table[$text = {1972092417, 90911}, $value = 'none'],
              table[$text = {1972092417, 90912}, $value = 'debug'],
              table[$text = {1972092417, 90913}, $value = 'trace']
            ]" />
            <set_value name="$debugLevelIndexes" exact="['none', 'debug', 'trace']" />
            <set_value name="$debugLevelCurrentIndex" exact="$debugLevelIndexes.indexof.{@$cfg.$debugLevel}" />
            <do_if value="$debugLevelCurrentIndex == 0">
              <set_value name="$debugLevelCurrentIndex" exact="1" />
            </do_if>
            <run_actions ref="md.Options_Helper.Add_Dropdown">
              <param name="id" value="'debugLevel'" />
              <param name="options" value="$debugLevelOptions" />
              <param name="currentIndex" value="$debugLevelCurrentIndex" />
              <param name="col" value="1" />
              <param name="textColSpan" value="6" />
              <param name="text" value="{1972092417, 90910}" />
              <param name="dropdownColSpan" value="6" />
              <param name="handle" value="Handle_Dropdown_Changed" />
            </run_actions>
            <remove_value name="$debugLevelOptions" />
            <remove_value name="$debugLevelIndexes" />
            <remove_value name="$debugLevelCurrentIndex" />
            <remove_value name="$cfg" />
          </actions>
        </cue>

        <cue name="Handle_Dropdown_Changed" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <set_value name="$resultTable" exact="player.entity.$SmartMinelayerConfig" />
            <include_actions ref="md.Options_Helper.Process_Dropdown_Changed" />
            <remove_value name="$resultTable" />
            <raise_lua_event name="'SmartMinelayer.ConfigChanged'" />
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'SmartMinelayer: Options: %s set to %s'.[event.param.$echo.$valueId, @event.param.$option.$value]" chance="$debugChance" />
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

        <cue name="Handle_Slider_Changed" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <set_value name="$resultTable" exact="player.entity.$SmartMinelayerConfig" />
            <include_actions ref="md.Options_Helper.Process_Slider_Changed" />
            <remove_value name="$resultTable" />
            <include_actions ref="ReadDebugChances" />
            <debug_text text="'SmartMinelayer: Options: %s set to %s'.[event.param.$echo.$valueId, event.param.$value]" chance="$debugChance" />
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

        <!-- AI scripts cannot receive event_ui_triggered, so the window's answer is relayed to the ship; param3 = the ship -->
        <cue name="ConfigReady" instantiate="true" version="1">
          <conditions>
            <event_ui_triggered screen="'SmartMinelayer'" control="'ConfigReady'" />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <do_if value="@event.param3.exists">
              <!-- the window's default for the next new order -->
              <do_if value="event.param3.pilot and event.param3.pilot.$SmartMinelayerRestockNpc?">
                <include_actions ref="Ensure_Config" />
                <set_value name="player.entity.$SmartMinelayerConfig.$restockNpc" exact="event.param3.pilot.$SmartMinelayerRestockNpc" />
              </do_if>
              <signal_objects object="event.param3" param="'SmartMinelayer.ConfigReady'" />
              <debug_text text="'SmartMinelayer: config ready for %s, restock at other factions %s'.[event.param3.debugname, @event.param3.pilot.$SmartMinelayerRestockNpc]" chance="$debugChance" />
            </do_if>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

        <cue name="ConfigCancelled" instantiate="true" version="1">
          <conditions>
            <event_ui_triggered screen="'SmartMinelayer'" control="'ConfigCancelled'" />
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <do_if value="@event.param3.exists">
              <signal_objects object="event.param3" param="'SmartMinelayer.ConfigCancelled'" />
              <debug_text text="'SmartMinelayer: config cancelled for %s'.[event.param3.debugname]" chance="$debugChance" />
            </do_if>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>

      </cues>
    </cue>

    <!-- an enemy ship killed by a mine or laser tower an order placed: experience as vanilla order.fight.attack.object grants it -->
    <cue name="KillExperience" namespace="this" version="2">
      <cues>
        <!-- the killer's slot in the common list holds it as an item record (kept a sweep past its destruction) -->
        <cue name="KillExperienceKill" instantiate="true">
          <conditions>
            <event_player_owned_killed_object />
            <check_value value="@player.entity.$SmartMinelayer.$slots.keys.count gt 0 and @event.param2.isclass.ship" />
            <check_value value="event.param2.trueowner.relationto.{faction.player} le faction.player.relation.killmilitary.max" />
          </conditions>
          <actions>
            <set_value name="$found" exact="false" />
            <do_for_each name="$key" valuename="$entry" in="player.entity.$SmartMinelayer.$slots">
              <do_if value="$entry.$items.{event.param}?">
                <set_value name="$ship" exact="@$entry.$ship" />
                <set_value name="$found" exact="true" />
                <break />
              </do_if>
            </do_for_each>
            <remove_value name="$key" />
            <remove_value name="$entry" />
            <do_if value="$found">
              <include_actions ref="ReadDebugChances" />
              <set_value name="$victim" exact="event.param2" />
              <!-- the wing shares the field, so the slot's ship, its Smart Minelayer leader and the leader's Assist wingmen all gain -->
              <set_value name="$group" exact="table[]" />
              <do_if value="@$ship.isoperational">
                <set_value name="$group.{$ship}" exact="true" />
              </do_if>
              <set_value name="$leader" exact="if @$ship.assignment == assignment.assist then @$ship.commander else $ship" />
              <do_if value="@$leader.isoperational and @$leader.defaultorder.id == 'SmartMinelayer'">
                <set_value name="$group.{$leader}" exact="true" />
                <do_for_each name="$member" in="$leader.subordinates.{assignment.assist}">
                  <set_value name="$group.{$member}" exact="true" />
                </do_for_each>
              </do_if>
              <do_for_each name="$member" in="$group.keys.list">
                <do_if value="@$member.isoperational and $member.isplayerowned and @$member.pilot.exists">
                  <!-- hard when the victim outweighs the ship; the fight takes no time, so the hard factor is vanilla's cap -->
                  <set_value name="$difficulty" exact="(@$victim.dps.all / [$member.dps.all, 1].max) + ($victim.maxhull / [$member.hull, 1].max * 0.5)" />
                  <set_value name="$category" exact="if $difficulty gt 2 then 'ship_kill_hard' else 'ship_kill_easy'" />
                  <apply_experience entity="$member.pilot" experience="$category" factor="1.0" />
                  <apply_experience object="$member" role="entityrole.service" experience="$category" factor="1.0" />
                  <do_if value="$category == 'ship_kill_hard'">
                    <apply_experience entity="$member.pilot" experience="'ship_kill_easy'" factor="1.0" />
                    <apply_experience object="$member" role="entityrole.service" experience="'ship_kill_easy'" factor="1.0" />
                  </do_if>
                  <debug_text text="'SmartMinelayer: %s killed %s (method %s), %s gains %s (difficulty %s)'.[event.param.debugname, $victim.debugname, event.param3, $member.debugname, $category, $difficulty]" chance="$debugChance" />
                  <remove_value name="$difficulty" />
                  <remove_value name="$category" />
                </do_if>
                <do_else>
                  <debug_text text="'SmartMinelayer: %s killed %s, no experience for %s: gone, not owned by the player or without a pilot'.[event.param.debugname, $victim.debugname, @$member.debugname]" chance="$debugChance" />
                </do_else>
              </do_for_each>
              <do_if value="$group.keys.count == 0">
                <debug_text text="'SmartMinelayer: %s killed %s, no wing to gain: slot ship %s'.[event.param.debugname, $victim.debugname, @$ship.debugname]" chance="$debugChance" />
              </do_if>
              <remove_value name="$member" />
              <remove_value name="$leader" />
              <remove_value name="$group" />
              <remove_value name="$victim" />
              <include_actions ref="ClearDebugChances" />
            </do_if>
            <remove_value name="$found" />
            <remove_value name="$ship" />
          </actions>
        </cue>
      </cues>
    </cue>

    <!-- param2 = mine or laser tower just launched, param3 = table from order.smart.minelayer.
         A warp restarts a mine's slide from rest: warp it onto its point, measure the slide, warp it one slide short. A tower undocks first and stays where it is warped. -->
    <cue name="SettleItem" instantiate="true" namespace="this">
      <conditions>
        <event_object_signalled object="player.galaxy" param="'SmartMinelayer.Settle'" />
      </conditions>
      <actions>
        <set_value name="$item" exact="event.param2" />
        <set_value name="$data" exact="event.param3" />
        <do_if value="$data.$mine">
          <warp object="$item" sector="$data.$sector">
            <position value="$data.$point" />
          </warp>
        </do_if>
      </actions>
      <cues>
        <cue name="SettleItemDone" checkinterval="500ms">
          <conditions>
            <check_any>
              <check_value value="not $item.exists or player.age ge $data.$start + 20s" />
              <check_value value="player.age ge $data.$start + 0.5s and $item.speed == 0 and ($data.$mine or not @$item.dock)" />
            </check_any>
          </conditions>
          <actions>
            <include_actions ref="ReadDebugChances" />
            <do_if value="$item.exists and $data.$mine">
              <create_position name="$stop" space="$data.$sector" object="$item" />
              <set_value name="$slide" exact="position.[$stop.x - $data.$point.x, $stop.y - $data.$point.y, $stop.z - $data.$point.z]" />
              <debug_text text="'SmartMinelayer: %s launched %s at %s m/s, warped onto position %s of slot %s, stopped after %ss, slide %s, moved to slide onto it'.[@$data.$ship.debugname, $item.debugname, $data.$launchSpeed, $data.$k, $data.$uid, player.age - $data.$start, $slide]" chance="$traceChance" />
              <warp object="$item" sector="$data.$sector">
                <position value="position.[$data.$point.x - $slide.x, $data.$point.y - $slide.y, $data.$point.z - $slide.z]" />
              </warp>
              <remove_value name="$slide" />
              <remove_value name="$stop" />
            </do_if>
            <do_elseif value="$item.exists">
              <debug_text text="'SmartMinelayer: %s launched %s, undocked %s and stopped after %ss %s from position %s of slot %s, moved onto it'.[@$data.$ship.debugname, $item.debugname, not @$item.dock, player.age - $data.$start, $item.distanceto.[$data.$sector, $data.$point], $data.$k, $data.$uid]" chance="$traceChance" />
              <warp object="$item" sector="$data.$sector">
                <position value="$data.$point" />
              </warp>
              <create_order object="$item" id="'Lasertower'" default="true" />
            </do_elseif>
            <include_actions ref="ClearDebugChances" />
          </actions>
        </cue>
      </cues>
    </cue>
  </cues>
</mdscript>
